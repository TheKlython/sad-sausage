# ==============================================================================
# ESPHome Secrets Template for Optoma Projector ESP32 Remote
# Rename this file to 'secrets.yaml' and configure your credentials.
# ==============================================================================

# Your local 2.4 GHz WiFi network credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback hotspot password if WiFi is unreachable (min. 8 characters)
fallback_ap_password: "YOUR_HOTSPOT_PASSWORD"

# Security by Design: Home Assistant Native API Encryption Key (Noise PSK)
# Generate your own unique 32-byte base64 key in terminal with:
# openssl rand -base64 32
api_key: "GENERATE_A_32_BYTE_BASE64_KEY_HERE="

# Security by Design: Password for Over-The-Air (OTA) firmware updates
ota_password: "YOUR_SECURE_OTA_PASSWORD"

# Security by Design: HTTP Basic Auth password for the built-in web server
web_server_password: "YOUR_WEB_SERVER_PASSWORD"
